ENVIRONMENT=production
FRONTEND_PORT=3000
API_PORT=8000
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://carbon:change-me@db:5432/carbon_link
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=["https://carbon.example.com"]
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
LOG_LEVEL=INFO

# Optional Avalanche / EVM anchoring
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NAME=avalanche-fuji
BLOCKCHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BLOCKCHAIN_CHAIN_ID=43113
BLOCKCHAIN_CONFIRMATIONS=3
BLOCKCHAIN_REQUEST_TIMEOUT_SECONDS=30
BLOCKCHAIN_WORKER_POLL_SECONDS=5
BLOCKCHAIN_WORKER_MAX_ATTEMPTS=10
CARBON_PROJECT_CONTRACT_ADDRESS=
CARBON_CREDIT_CONTRACT_ADDRESS=
BLOCKCHAIN_OPERATOR_ADDRESS=
# Choose exactly one signing mode. Prefer an external signer in production.
BLOCKCHAIN_SIGNER_URL=
BLOCKCHAIN_OPERATOR_PRIVATE_KEY=

# Password reset email. In non-production without SMTP, the UI displays a development reset token.
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520

# Optional: enables LLM-polished guidance in the LangGraph application agent.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
PASSWORD_RESET_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
