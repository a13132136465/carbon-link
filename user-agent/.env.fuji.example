# Never commit the real version of this file.
CARBONLINK_BASE_URL=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

BLOCKCHAIN_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BLOCKCHAIN_CHAIN_ID=43113
USDC_CONTRACT_ADDRESS=

# Dedicated test-only mnemonic used to derive one wallet per simulated user.
TEST_WALLET_MNEMONIC=

# Testnet-only wallet that distributes AVAX for gas. Never use a mainnet wallet.
FUJI_FUNDER_PRIVATE_KEY=

# Optional USDC distributor. For canonical Circle testnet USDC it must hold enough
# tokens; for the repository's TestUSDC it may instead be the mint owner.
# Falls back to FUJI_FUNDER_PRIVATE_KEY.
FUJI_USDC_FUNDER_PRIVATE_KEY=

# Conservative defaults; CLI flags may override them.
FUJI_GAS_PER_WALLET=0.03
FUJI_MAX_GAS_PER_WALLET=0.08
FUJI_MAX_GAS_PER_BATCH=1.0
FUJI_USDC_PER_BUYER=1000
FUJI_MAX_USDC_PER_WALLET=5000
FUJI_MAX_USDC_PER_BATCH=50000
